{
  "_about": "Behavioral scenarios derived by hand from the ORIGINAL ZZT-OOP in output/zzt/<world>/ir/ir.json. Board coordinates in the harness are 0-based. Steps `touch`/`takeItem`/`edge` put the player on a free neighbouring cell first (a teleport standing in for walking there) and then press the arrow key that walks into the target, so the handler under test runs through the real input path. Run: node eval/behave.mjs zzt",
  "crimring-crimring": {
    "notes": "Demo world starting on the Credits board (39): a timed #send all:<label> chain spells the credits and finally #send door:die opens the way to the passage.",
    "scenarios": [
      {
        "name": "P starts on the Credits board",
        "source": "header current board = 39",
        "steps": [
          {
            "start": true
          },
          {
            "expect": {
              "state": "play",
              "screen": "board-39"
            }
          }
        ]
      },
      {
        "name": "#send all:design makes the letters appear",
        "source": "object #78: /i x13; #send all:design; objects :design #char 68 ('D') etc.",
        "steps": [
          {
            "start": true
          },
          {
            "waitFor": {
              "js": "game.board.entities.some(o => o.x === 26 && o.y === 7 && o.ch === 68)",
              "timeout": 20000
            }
          },
          {
            "expect": {
              "js": {
                "label": "object at (27,8) shows 'D'",
                "code": "game.board.entities.find(o => o.x === 26 && o.y === 7).ch",
                "equals": 68
              }
            }
          }
        ]
      },
      {
        "name": "#send all:goaway removes the bound objects",
        "source": "#78: #send all:goaway; @goaway :goaway #die (and #bind goaway copies)",
        "steps": [
          {
            "start": true
          },
          {
            "waitFor": {
              "js": "!game.board.entities.some(o => o.name === 'goaway' && !o.dead)",
              "timeout": 30000
            }
          },
          {
            "expect": {
              "js": {
                "label": "no live goaway-bound objects",
                "code": "game.board.entities.filter(o => !o.dead && o.x === 18 && o.y < 24).length",
                "equals": 0
              }
            }
          }
        ]
      },
      {
        "name": "Chain ends with #send door:die, then the passage leads to board 2",
        "source": "#78: ... #send door:die; passage (31,25) -> board-2",
        "steps": [
          {
            "start": true
          },
          {
            "waitFor": {
              "js": "!game.board.entities.some(o => o.name === 'door' && !o.dead)",
              "timeout": 45000
            }
          },
          {
            "touch": "board-39-stat-113"
          },
          {
            "expect": {
              "screen": "board-2"
            }
          }
        ]
      }
    ]
  },
  "dammak-dammak": {
    "notes": "Town board: shops with !choices, #take with a fail label, #send to another object, #put, #zap, #give.",
    "scenarios": [
      {
        "name": "Intro text then 10 gems",
        "source": "@intro: text; #give gems 10; #die",
        "steps": [
          {
            "start": true
          },
          {
            "waitFor": {
              "js": "rt.dialogOpen",
              "timeout": 5000
            }
          },
          {
            "expect": {
              "dialog": {
                "contains": "As you approach the little town"
              }
            }
          },
          {
            "dismiss": true
          },
          {
            "wait": 600
          },
          {
            "expect": {
              "counter": {
                "name": "gems",
                "equals": 10
              },
              "entityAlive": {
                "name": "intro",
                "value": false
              }
            }
          }
        ]
      },
      {
        "name": "Innkeeper: buy a room (take 3 gems, send door:bought, put blue key)",
        "source": "@Innkeeper :touch !x1 -> :x1 #take gems 3 getout; #send door:bought; #put w blue key",
        "steps": [
          {
            "start": true
          },
          {
            "waitFor": {
              "js": "rt.dialogOpen",
              "timeout": 5000
            }
          },
          {
            "dismiss": true
          },
          {
            "wait": 600
          },
          {
            "touch": "Innkeeper",
            "from": "east"
          },
          {
            "expect": {
              "dialog": {
                "contains": "would you like a room"
              }
            }
          },
          {
            "answer": "Yes,I'll take it."
          },
          {
            "wait": 800
          },
          {
            "expect": {
              "counter": {
                "name": "gems",
                "equals": 7
              },
              "shown": {
                "contains": "room at the end of the hall"
              }
            }
          },
          {
            "dismiss": true
          },
          {
            "wait": 600
          },
          {
            "expect": {
              "entityAlive": {
                "name": "door",
                "value": false
              },
              "js": {
                "label": "blue key west of the innkeeper",
                "code": "game.board.el[22*60+23] === 8 && (game.board.fg[22*60+23] & 7) === 1"
              }
            }
          }
        ]
      },
      {
        "name": "Innkeeper without gems sends you away",
        "source": ":x1 #take gems 3 getout -> :getout You haven't got 3 gems!",
        "steps": [
          {
            "start": true
          },
          {
            "waitFor": {
              "js": "rt.dialogOpen",
              "timeout": 5000
            }
          },
          {
            "dismiss": true
          },
          {
            "wait": 600
          },
          {
            "setup": "rt.set('gems', 1)"
          },
          {
            "touch": "Innkeeper"
          },
          {
            "answer": "Yes,I'll take it."
          },
          {
            "wait": 800
          },
          {
            "expect": {
              "shown": {
                "contains": "You haven't got 3 gems!"
              },
              "counter": {
                "name": "gems",
                "equals": 1
              }
            }
          }
        ]
      },
      {
        "name": "Firewood box gives 20 torches once",
        "source": "@Box :touch ... #give torches 20; #zap touch",
        "steps": [
          {
            "start": true
          },
          {
            "waitFor": {
              "js": "rt.dialogOpen",
              "timeout": 5000
            }
          },
          {
            "dismiss": true
          },
          {
            "wait": 600
          },
          {
            "touch": "Box"
          },
          {
            "expect": {
              "dialog": {
                "contains": "old firewood box"
              }
            }
          },
          {
            "dismiss": true
          },
          {
            "wait": 500
          },
          {
            "expect": {
              "counter": {
                "name": "torches",
                "equals": 20
              }
            }
          },
          {
            "mark": true
          },
          {
            "touch": "Box"
          },
          {
            "wait": 500
          },
          {
            "expect": {
              "counter": {
                "name": "torches",
                "equals": 20
              },
              "shown": false
            }
          }
        ]
      },
      {
        "name": "Broadsword: flag, 50 points, disappears",
        "source": "@Broadsword :touch #set broadsword; #give score 50; #die",
        "steps": [
          {
            "start": true
          },
          {
            "waitFor": {
              "js": "rt.dialogOpen",
              "timeout": 5000
            }
          },
          {
            "dismiss": true
          },
          {
            "wait": 600
          },
          {
            "touch": "Broadsword"
          },
          {
            "dismiss": true
          },
          {
            "wait": 600
          },
          {
            "expect": {
              "counter": {
                "name": "score",
                "equals": 50
              },
              "flag": {
                "name": "broadsword",
                "value": true
              },
              "entityAlive": {
                "name": "Broadsword",
                "value": false
              }
            }
          }
        ]
      },
      {
        "name": "North edge leads to board 2",
        "source": "board-1 exit north = board-2",
        "steps": [
          {
            "start": true
          },
          {
            "waitFor": {
              "js": "rt.dialogOpen",
              "timeout": 5000
            }
          },
          {
            "dismiss": true
          },
          {
            "wait": 600
          },
          {
            "edge": "north"
          },
          {
            "expect": {
              "screen": "board-2"
            }
          }
        ]
      },
      {
        "name": "Golden box: #if book then check 2 reaches :check2 (book, candle, bell open it) (added in iteration 2)",
        "open": "board=14",
        "source": "@Box :touch #if book then check 2 / :check2 #if candle then check3 / :check3 #if bell then open / :open text, #char 007, #zap touch",
        "steps": [
          {
            "start": true
          },
          {
            "setup": "rt.setFlag('book'); rt.setFlag('candle'); rt.setFlag('bell');"
          },
          {
            "touch": "Box"
          },
          {
            "expect": {
              "dialog": {
                "contains": "peels back"
              }
            }
          }
        ]
      },
      {
        "name": "Dark board: message on entry, T lights a torch (added in iteration 2)",
        "open": "board=14",
        "source": "board 14 dark flag (SPEC 2.5 prop 1); engine design: torches light an 8x5 ellipse",
        "steps": [
          {
            "start": true
          },
          {
            "expect": {
              "shown": {
                "contains": "Room is dark"
              }
            }
          },
          {
            "setup": "rt.set('torches', 2);"
          },
          {
            "key": "t"
          },
          {
            "expect": {
              "counter": {
                "name": "torches",
                "equals": 1
              },
              "js": {
                "label": "torch burning",
                "code": "game.torch > 0"
              }
            }
          }
        ]
      }
    ]
  },
  "kingl2-kingl2": {
    "notes": "First board: signs, a statue with a !choice reward, dynamite with #take energy, items and a passage.",
    "scenarios": [
      {
        "name": "Statue: kiss the brow for 20 gems, then no more",
        "source": "@Statue :touch !x1 -> :x1 #give gems 20; #zap touch -> second :touch",
        "steps": [
          {
            "start": true
          },
          {
            "touch": "Statue Of Chulmir"
          },
          {
            "expect": {
              "dialog": {
                "contains": "statue of Chulmir"
              }
            }
          },
          {
            "answer": "Kiss Chulmir's brow."
          },
          {
            "wait": 800
          },
          {
            "expect": {
              "counter": {
                "name": "gems",
                "equals": 20
              }
            }
          },
          {
            "dismiss": true
          },
          {
            "mark": true
          },
          {
            "touch": "Statue Of Chulmir"
          },
          {
            "wait": 800
          },
          {
            "expect": {
              "shown": {
                "contains": "no more gems"
              },
              "counter": {
                "name": "gems",
                "equals": 20
              }
            }
          }
        ]
      },
      {
        "name": "Arsenal sign text",
        "source": "@Arsenal Sign :touch",
        "steps": [
          {
            "start": true
          },
          {
            "touch": "Arsenal Sign"
          },
          {
            "expect": {
              "dialog": {
                "contains": "Beyond this wall lies King"
              }
            }
          }
        ]
      },
      {
        "name": "Dynamite explodes and disappears",
        "source": "@Dynamite :touch You set off the dynamite!; #take energy 5; #die",
        "steps": [
          {
            "start": true
          },
          {
            "touch": "Dynamite"
          },
          {
            "wait": 800
          },
          {
            "expect": {
              "shown": {
                "contains": "You set off the dynamite!"
              },
              "entityAlive": {
                "name": "Dynamite",
                "value": false
              }
            }
          }
        ]
      },
      {
        "name": "Picking up ammo adds 5",
        "source": "built-in ammo element (5)",
        "steps": [
          {
            "start": true
          },
          {
            "snapshot": true
          },
          {
            "takeItem": 5
          },
          {
            "expect": {
              "counter": {
                "name": "ammo",
                "delta": 5
              }
            }
          }
        ]
      },
      {
        "name": "Picking up a torch adds 1",
        "source": "built-in torch element (6)",
        "steps": [
          {
            "start": true
          },
          {
            "snapshot": true
          },
          {
            "takeItem": 6
          },
          {
            "expect": {
              "counter": {
                "name": "torches",
                "delta": 1
              }
            }
          }
        ]
      },
      {
        "name": "Passage leads to board 2",
        "source": "passage (2,2) -> board-2",
        "steps": [
          {
            "start": true
          },
          {
            "touch": "board-1-stat-1"
          },
          {
            "expect": {
              "screen": "board-2"
            }
          }
        ]
      },
      {
        "name": "Release Lever: #change sliderns/sliderew fake wall (added in iteration 2)",
        "open": "board=2",
        "source": "@Release Lever :touch #change sliderns fake wall; #change sliderew fake wall",
        "steps": [
          {
            "start": true
          },
          {
            "expect": {
              "js": {
                "label": "sliders on the board",
                "code": "[...game.board.el].some(e => e === 25 || e === 26)"
              }
            }
          },
          {
            "touch": "Release Lever"
          },
          {
            "wait": 1500
          },
          {
            "expect": {
              "js": {
                "label": "no sliders left",
                "code": "![...game.board.el].some(e => e === 25 || e === 26)"
              }
            }
          }
        ]
      },
      {
        "name": "Lions move once the player presses a key (added in iteration 2)",
        "open": "board=8",
        "source": "141 lions (element 41, p1 intelligence); engine design: random or seeking steps",
        "steps": [
          {
            "start": true
          },
          {
            "setup": "window.__pos = game.board.entities.filter(o => o.el === 41).map(o => o.x + ',' + o.y);"
          },
          {
            "key": "Space"
          },
          {
            "wait": 3000
          },
          {
            "expect": {
              "js": {
                "label": ">= 20 lions moved",
                "code": "game.board.entities.filter(o => o.el === 41 && !o.dead && !window.__pos.includes(o.x + ',' + o.y)).length >= 20"
              }
            }
          }
        ]
      },
      {
        "name": "A lion that reaches the player costs 10 health and dies (added in iteration 2)",
        "open": "board=8",
        "source": "engine design: creature attack = -10 health, the creature is destroyed",
        "steps": [
          {
            "start": true
          },
          {
            "setup": "game.board.entities.find(o => o.el === 41 && __H.approach(o.x, o.y)); game.board.entities.forEach(o => { if (o.el === 41) o.p1 = 10; }); window.__lions = game.board.entities.filter(o => o.el === 41 && !o.dead).length;"
          },
          {
            "key": "Space"
          },
          {
            "waitFor": {
              "js": "rt.get('health') < 100",
              "timeout": 8000
            }
          },
          {
            "expect": {
              "js": {
                "label": "fewer lions",
                "code": "game.board.entities.filter(o => o.el === 41 && !o.dead).length < window.__lions"
              }
            }
          }
        ]
      },
      {
        "name": "Energizer makes the player invincible (added in iteration 2)",
        "open": "board=4",
        "source": "element 14 (the board's one is walled in by items, so one is placed next to the player); engine design: 75 ticks, all:energize",
        "steps": [
          {
            "start": true
          },
          {
            "setup": "const g = game, b = g.board; for (let i = 61; i < 1500; i++) { const x = i % 60, y = (i / 60) | 0; if (x > 0 && b.el[i] === 0 && g._free(b, x, y) && g._free(b, x - 1, y)) { b.el[i] = 14; b.fg[i] = 5; b.ch[i] = -1; g.player.x = x - 1; g.player.y = y; g.keys.clear(); g.queued = []; return; } }"
          },
          {
            "key": "ArrowRight"
          },
          {
            "expect": {
              "shown": {
                "contains": "Energizer"
              },
              "js": {
                "label": "energized",
                "code": "game.energy > 0"
              }
            }
          }
        ]
      }
    ]
  },
  "lostmonk-lostmonk": {
    "notes": "Starts on the intro credits board (9) -> passage -> 28 -> passage -> 1 (the boat). Boat board tested with ?board=1.",
    "scenarios": [
      {
        "name": "Credits passage chain reaches the boat",
        "source": "board-9 passage -> board-28; board-28 passage -> board-1",
        "steps": [
          {
            "start": true
          },
          {
            "expect": {
              "screen": "board-9"
            }
          },
          {
            "touch": "board-9-stat-25"
          },
          {
            "expect": {
              "screen": "board-28"
            }
          },
          {
            "touch": "board-28-stat-2"
          },
          {
            "expect": {
              "screen": "board-1"
            }
          }
        ]
      },
      {
