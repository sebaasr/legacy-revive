  "zzttoxic-toxhints": {
    "notes": "Single-board hints browser: one object whose !choices jump between menu labels. 4 scenarios cover all its logic.",
    "scenarios": [
      {
        "name": "Touching the hints object shows intro and main menu in one window",
        "source": "@HINTS & SOLUTIONS :TOUCH (text) :MAIN !PART1 !PART2 !PART3 #END (a label does not end a message in ZZT)",
        "steps": [
