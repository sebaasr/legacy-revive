 "lostmonk-lostmonk": {
  "scenarios": [
   {
    "name": "HO Sack: the whole item chain (ammo 50, torches 5, health 20, banana, rope, score 60)",
    "source": "@Sack :A ... #give score 10; #give ammo 50 / #give score 10; #give torches 5 / #give score 20; #give health 20 / #set banana; #give score 10 / #set rope; #give score 10; #zap touch",
    "open": "board=1",
    "steps": [
     {
      "waitFor": {
       "js": "rt.dialogOpen",
       "timeout": 6000
      }
     },
     {
      "dismiss": true,
      "times": 3
     },
     {
      "wait": 500
     },
     {
      "snapshot": true
     },
     {
      "touch": "Sack"
     },
     {
      "answer": "Open the sack"
     },
     {
      "wait": 1000
     },
     {
      "dismiss": true,
      "times": 2
     },
     {
      "waitFor": {
       "js": "rt.hasFlag('rope')",
       "timeout": 20000
      }
     },
     {
      "wait": 300
     },
     {
      "expect": {
       "counter": {
        "name": "ammo",
        "delta": 50
       }
      }
     },
     {
      "expect": {
       "counter": {
        "name": "torches",
        "delta": 5
       }
      }
     },
     {
      "expect": {
       "counter": {
        "name": "health",
        "delta": 20
       }
      }
     },
     {
      "expect": {
       "counter": {
        "name": "score",
        "delta": 60
       },
       "flag": {
        "name": "banana",
        "value": true
       }
      }
     }
    ]
   },
   {
    "name": "HO Controls: Eject -> No",
    "source": "@Controls !C;_Eject_ -> :C Are you sure ... !Y;Yes !N;No -> :N You decide not to eject.; #restart",
    "open": "board=1",
    "steps": [
     {
      "waitFor": {
       "js": "rt.dialogOpen",
       "timeout": 6000
      }
     },
     {
      "dismiss": true,
      "times": 3
     },
     {
      "wait": 500
     },
     {
      "snapshot": true
     },
     {
      "touch": "Controls"
     },
     {
      "answer": "_Eject_"
     },
     {
      "wait": 800
     },
     {
      "expect": {
       "dialog": {
        "contains": "eject your"
       }
      }
     },
     {
      "answer": "No"
     },
     {
      "wait": 800
     },
     {
      "expect": {
       "shown": {
        "contains": "You decide not to eject"
       },
       "counter": {
        "name": "score",
        "delta": 0
       }
      }
     }
    ]
   }
  ]
 },
