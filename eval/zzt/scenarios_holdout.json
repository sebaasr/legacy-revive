{
 "_about": "HOLD-OUT scenarios written by the Verifier in iteration 2, never shown to the Modernizer. Derived by hand from the ORIGINAL ZZT-OOP in output/zzt/<world>/ir/ir.json, targeting objects and commands the main scenarios.json does not exercise (#bind copies, #zap with duplicate labels, #become, :shot, multi-step #give chains, menus reached through #send-to-self). Run: node eval/behave.mjs zzt <world> --holdout (writes eval/zzt/behave_holdout/).",
 "crimring-crimring": {
  "scenarios": [
   {
    "name": "HO Toilet: #zap touch exposes the second :touch label",
    "source": "board-2 @Toilet :touch #lock; #zap touch; $The Toilet ... /i/i/i; #play; <<FLUSH>>; #unlock / :touch You don't have to go, stupid!",
    "open": "board=2",
    "steps": [
     {
      "start": true
     },
     {
      "waitFor": {
       "js": "rt.dialogOpen",
       "timeout": 6000
      }
     },
     {
      "dismiss": true,
      "times": 3
     },
     {
      "wait": 500
     },
     {
      "touch": "Toilet"
     },
     {
      "waitFor": {
       "js": "rt.dialogOpen",
       "timeout": 4000
      }
     },
     {
      "expect": {
       "dialog": {
        "contains": "relieve yourself"
       }
      }
     },
     {
      "dismiss": true
     },
     {
      "waitFor": {
       "js": "window.__shown.some(s => s.text.includes('FLUSH'))",
       "timeout": 10000
      }
     },
     {
      "wait": 800
     },
     {
      "mark": true
     },
     {
      "touch": "Toilet"
     },
     {
      "wait": 800
     },
     {
      "expect": {
       "shown": {
        "contains": "You don't have to go"
       }
      }
     }
    ]
   },
   {
    "name": "HO Bed without the bedtime flag",
    "source": "board-2 @bed :touch #if bedtime then sleep; This is NOT the time to take a snooze!",
    "open": "board=2",
    "steps": [
     {
      "start": true
     },
     {
      "waitFor": {
       "js": "rt.dialogOpen",
       "timeout": 6000
      }
     },
     {
      "dismiss": true,
      "times": 3
     },
     {
      "wait": 500
     },
     {
      "mark": true
     },
     {
      "touch": "bed"
     },
     {
      "wait": 600
     },
     {
      "expect": {
       "shown": {
        "contains": "NOT the time to take a snooze"
       }
      }
     }
    ]
   }
  ]
 },
