 "zzttoxic-toxic": {
  "scenarios": [
   {
    "name": "HO Shooting the barrel runs its :SHOT label (#DIE)",
    "source": "@BARREL board-1-stat-15 :SHOT #DIE (a second BARREL object, stat-16, shares the program, so the id is used)",
    "steps": [
     {
      "start": true
     },
     {
      "setup": "rt.set('ammo', 5); const o = __H.entity('board-1-stat-15'); window.__k = __H.approach(o.x, o.y, 'west');"
     },
     {
      "expect": {
       "js": {
        "label": "player west of the barrel",
        "code": "window.__k",
        "equals": "ArrowRight"
       }
      }
     },
     {
      "key": "Shift+ArrowRight"
     },
     {
      "wait": 900
     },
     {
      "expect": {
       "entityAlive": {
        "name": "board-1-stat-15",
        "value": false
       },
       "counter": {
        "name": "ammo",
        "equals": 4
       }
      }
     }
    ]
   },
   {
    "name": "HO BARREL1 (#bind BARREL) shows the barrel text",
