 "zzttoxic-smiley": {
  "scenarios": [
   {
    "name": "HO A WOODS object turns into a gem (#become gem)",
    "source": "board-2-stat-15 @WOODS :TOUCH #PLAY ++ICG; #BECOME GEM. The object sits inside forest; one neighbouring forest tile is cleared first (the player clears forest by walking through it)",
    "open": "board=2",
    "steps": [
     {
      "wait": 500
     },
     {
      "dismiss": true,
      "times": 3
     },
     {
      "setup": "const g = game, b = g.board, o = __H.entity('board-2-stat-15'); window.__c = o.y * 60 + o.x; for (const [dx, dy] of [[-1,0],[1,0],[0,-1],[0,1]]) { const i = (o.y + dy) * 60 + o.x + dx; if (b.el[i] === 20 && !b.at.has(i)) { b.el[i] = 0; b.ch[i] = 32; window.__cleared = i; return; } }"
     },
     {
      "expect": {
       "js": {
        "label": "a forest neighbour was cleared",
        "code": "window.__cleared != null"
       }
      }
     },
     {
      "touch": "board-2-stat-15"
     },
     {
      "wait": 700
     },
     {
      "expect": {
       "js": {
        "label": "the cell is now a gem (element 7)",
        "code": "game.board.el[window.__c]",
        "equals": 7
       }
      }
     },
     {
      "expect": {
       "entityAlive": {
        "name": "board-2-stat-15",
        "value": false
       }
      }
     }
    ]
   },
   {
    "name": "HO BONUS: first touch reveals, second touch pays 10 gems, 10 health, 100 points",
    "source": "@BONUS :TOUCH #CHAR 04; #ZAP TOUCH / :TOUCH Bonus gem worth 10 gems; #GIVE GEMS 10; #GIVE HEALTH 10; #GIVE SCORE 100; #DIE",
    "open": "board=2",
    "steps": [
     {
      "wait": 500
     },
     {
      "dismiss": true,
      "times": 3
     },
     {
      "snapshot": true
     },
     {
      "touch": "BONUS"
     },
     {
      "wait": 500
     },
     {
      "expect": {
       "counter": {
        "name": "gems",
        "delta": 0
       }
      }
     },
     {
      "touch": "BONUS"
     },
     {
      "wait": 700
     },
     {
      "expect": {
       "counter": {
        "name": "gems",
        "delta": 10
       }
      }
     },
     {
      "expect": {
       "counter": {
        "name": "health",
        "delta": 10
       }
      }
     },
     {
      "expect": {
       "counter": {
        "name": "score",
        "delta": 100
       }
      }
     },
     {
      "expect": {
       "entityAlive": {
        "name": "BONUS",
        "value": false
       }
      }
     }
    ]
   }
  ]
 },
