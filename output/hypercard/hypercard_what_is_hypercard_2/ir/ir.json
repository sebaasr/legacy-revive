   "layer_text": {
    "bkgnd-2619/field-24": "What's Next\r\rYou’re ready to start exploring HyperCard stacks! \r\rYour Home stack is a good place to start exploring. \rTo go Home, click the Home button at the bottom of this card.\r\rIf you want to stop using HyperCard for now, choose Quit HyperCard from the File menu.",
    "bkgnd-2619/field-26": "What's Next\r\rYou’re ready to start exploring HyperCard stacks! \r\rYour Home stack is a good place to start exploring. \rTo go Home, click the Home button at the bottom of this card.\r\rIf you want to stop using HyperCard for now, choose Quit HyperCard from the File menu."
   },
   "script": null,
   "grid": null
  }
